/* Design tokens:  home for asset references + shared values used across Frankie's UI Toolkit styles */
/* Note:  USS asset urls embed path + guid, and moved/renamed assets need their path updated here (only) */

:root {
    /* Assets */
    --font-default: url("project://database/Assets/z_ImportedAssets/EB-Fonts/apple_kid%20SDF_UITK.asset?fileID=11400000&guid=da9ec84fcc9a14f15a8a490838a9a40e&type=2#apple_kid SDF_UITK");
    --font-display: url("project://database/Assets/z_ImportedAssets/EB-Fonts/foursideVector%20SDF.asset?fileID=11400000&guid=06badb9dd82684bc6857efcc4560922d&type=2#foursideVector SDF");
    --frame-image: url("project://database/Assets/z_MadeAssets/BattleUI/MenuFrame.png?fileID=21300000&guid=f30d85e6afc224fe9a89251a4c2dab80&type=3#MenuFrame");

    --font-slide-name: url("project://database/Assets/z_ImportedAssets/EB-Fonts/twosonVector%20SDF.asset?fileID=11400000&guid=335f59fb5bb284859a1496faf0aca5e7&type=2#twosonVector SDF");
    --font-slide-digits: url("project://database/Assets/z_ImportedAssets/EB-Fonts/statusplz.ttf?fileID=12800000&guid=c000ddec05b41574396a4a0ec75ea958&type=3#statusplz");

    /* Character slides */
    --slide-name-pane-image: url("project://database/Assets/z_MadeAssets/BattleUI/Checker2-Grayscale.png?fileID=21300000&guid=9c5b8914086924e4c80126cee6477e77&type=3#Checker2-Grayscale");
    --slide-stats-pane-image: url("project://database/Assets/z_MadeAssets/BattleUI/Checker1-Grayscale.png?fileID=21300000&guid=793e28adecf114dc193a16e165547e21&type=3#Checker1-Grayscale");
    --slide-stat-slot-image: url("project://database/Assets/z_MadeAssets/BattleUI/StatSlot.png?fileID=21300000&guid=a7e18126c57ba4e6991f21b661ff49d9&type=3#StatSlot");

    /* Status effects */
    --status-healing-image: url("project://database/Assets/z_MadeAssets/StatusEffects/HPAdjustPositive.png?fileID=21300000&guid=d490b2ae44447c6409e83de7546b496c&type=3#HPAdjustPositive");
    --status-damage-image: url("project://database/Assets/z_MadeAssets/StatusEffects/HPAdjustNegative.png?fileID=21300000&guid=7f1a0e20b55a49c4cb16f889f99b6367&type=3#HPAdjustNegative");
    --status-brawn-image: url("project://database/Assets/z_MadeAssets/StatusEffects/BrawnAdjust.png?fileID=21300000&guid=eb33630a87c2b024898dadd82295ec5d&type=3#BrawnAdjust");
    --status-beauty-image: url("project://database/Assets/z_MadeAssets/StatusEffects/BeautyAdjust.png?fileID=21300000&guid=b3d82a531e9d32143a484860eb26dc0a&type=3#BeautyAdjust");
    --status-smarts-image: url("project://database/Assets/z_MadeAssets/StatusEffects/SmartsAdjust.png?fileID=21300000&guid=191ea053d2e173348a32424eff4ae54f&type=3#SmartsAdjust");
    --status-nimble-image: url("project://database/Assets/z_MadeAssets/StatusEffects/NimbleAdjust.png?fileID=21300000&guid=e4ad80e5e3c4c8347b81dd8b2821173d&type=3#NimbleAdjust");
    --status-luck-image: url("project://database/Assets/z_MadeAssets/StatusEffects/LuckAdjust.png?fileID=21300000&guid=9c49405c0e5cc5f4e9e6ca75e69406e6&type=3#LuckAdjust");
    --status-pluck-image: url("project://database/Assets/z_MadeAssets/StatusEffects/PluckAdjust.png?fileID=21300000&guid=96e739e9dad189a4e994cdf78dffbd46&type=3#PluckAdjust");
    --status-stoic-image: url("project://database/Assets/z_MadeAssets/StatusEffects/StoicAdjust.png?fileID=21300000&guid=3d71af6cac05941709f3acdfe5a9a253&type=3#StoicAdjust");
    --status-increase-image: url("project://database/Assets/z_MadeAssets/StatusEffects/Increase.png?fileID=21300000&guid=c57e5cc458f1cec48beac0209efb4e2c&type=3#Increase");
    --status-decrease-image: url("project://database/Assets/z_MadeAssets/StatusEffects/Decrease.png?fileID=21300000&guid=1d7686a6c7fe4f14397edd84e7c4cfc2&type=3#Decrease");

    /* Naming screen */
    --naming-backdrop-image: url("project://database/Assets/z_ImportedAssets/EB-BattleBackgrounds/041.png?fileID=21300000&guid=e29be70c9febd64428840a5f7cb924d8&type=3#041");

    /* Frame */
    --frame-slice: 18;
    --frame-flavour-default: rgb(184, 255, 255);

    /* Text */
    --font-size-default: 64px;
    --text-colour-default: rgb(255, 255, 255);
    --choice-dimmed-colour: rgb(128, 128, 128);
    --choice-selected-colour: rgb(124, 252, 0);

    /* Inventory */
    --equipped-marker-colour: rgb(163, 109, 238);
    --stat-better-colour: rgb(0, 255, 0);
    --stat-worse-colour: rgb(255, 0, 0);

    /* Pointer feedback */
    --choice-hover-colour: rgb(124, 171, 171);
    --choice-pressed-colour: rgb(51, 70, 70);
    --choice-tint-duration: 0.1s;
    --slide-hover-tint: rgb(200, 200, 200);
    --slide-pressed-tint: rgb(140, 140, 140);
    --slide-hover-opacity: 0.8;
    --slide-pressed-opacity: 0.55;

    /* Box */
    --backing-colour: rgb(0, 0, 0);
}

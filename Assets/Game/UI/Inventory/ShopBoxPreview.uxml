<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uibox="LowDefMustard.UIBox" xmlns:frankie="Frankie.Utils.UI" xmlns:inventory="Frankie.Inventory.UI" editor-extension-mode="false">
    <!-- UI Builder preview only (set canvas to 2560x1440):  mirrors ShopBox.uxml with sample entries - keep in sync -->
    <!-- Style order matches ShopBox's view:  shared theme sheets, then screen sheets -->
    <Style src="../_UIToolkit/Styles/Tokens.uss" />
    <Style src="../_UIToolkit/Styles/UIBox.uss" />
    <Style src="ShopBox.uss" />
    <ui:VisualElement class="shop-box-screen" picking-mode="Ignore">
        <ui:VisualElement class="uibox shop-box">
            <ui:VisualElement class="uibox__backing" picking-mode="Ignore" />
            <frankie:FrameElement class="uibox__frame" />
            <inventory:ShopMessageLabel text="What do you want to buy?" class="shop-box__message" picking-mode="Ignore" />
            <uibox:ChoiceEntryContainer choice-layout="Vertical" class="shop-box__stock" picking-mode="Ignore">
                <inventory:ShopStockElement name-text="Broken Keyboard" price-text="12" highlighted="true" />
                <inventory:ShopStockElement name-text="Simple Keyboard" price-text="75" />
                <inventory:ShopStockElement name-text="Thin Vest" price-text="65" />
                <inventory:ShopStockElement name-text="Casio Watch" price-text="130" />
            </uibox:ChoiceEntryContainer>
            <uibox:BackExitButton class="uibox__back-exit">
                <ui:VisualElement class="uibox-back-exit__backing" picking-mode="Ignore" />
                <frankie:FrameElement class="uibox-back-exit__frame" />
                <ui:Label text="x" class="uibox-back-exit__label" picking-mode="Ignore" />
            </uibox:BackExitButton>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

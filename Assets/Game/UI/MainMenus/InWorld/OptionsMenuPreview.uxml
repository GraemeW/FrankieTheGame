<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uibox="LowDefMustard.UIBox" xmlns:frankie="Frankie.Utils.UI" xmlns:menu="Frankie.Menu.UI" editor-extension-mode="false">
    <!-- UI Builder preview only (set canvas to 2560x1440):  mirrors OptionsMenu.uxml with sample entries - keep in sync -->
    <!-- Style order matches OptionsMenuUITK's view:  shared theme sheets, then screen sheets -->
    <Style src="../../_UIToolkit/Styles/Tokens.uss" />
    <Style src="../../_UIToolkit/Styles/UIBox.uss" />
    <Style src="OptionsMenu.uss" />
    <ui:VisualElement class="options-menu-screen" picking-mode="Ignore">
        <ui:VisualElement class="uibox options-menu">
            <ui:VisualElement class="uibox__backing" picking-mode="Ignore" />
            <frankie:FrameElement class="uibox__frame" />
            <menu:OptionsHeaderLabel text="Options Menu" class="options-menu__header" picking-mode="Ignore" />
            <ui:VisualElement class="options-menu__body" picking-mode="Ignore">
                <menu:OptionsVolumeSection class="options-menu__volume">
                    <uibox:SliderChoiceElement label-text="Master Volume" value="0.8" highlighted="true" />
                    <uibox:SliderChoiceElement label-text="Background Volume" value="0.5" />
                    <uibox:SliderChoiceElement label-text="SFX Volume" value="0.7" />
                </menu:OptionsVolumeSection>
                <menu:OptionsDisplaySection class="options-menu__display">
                    <uibox:ToggleChoiceElement label-text="Windowed FullScreen" is-on="true" />
                </menu:OptionsDisplaySection>
                <menu:OptionsResolutionsHeaderLabel text="Windowed Resolutions" class="options-menu__section-header" picking-mode="Ignore" />
                <menu:OptionsResolutionSection class="options-menu__resolutions">
                    <uibox:ChoiceEntryElement label-text="Default: 1920 x 1080" />
                    <uibox:ChoiceEntryElement label-text="1600 x 900" />
                </menu:OptionsResolutionSection>
                <menu:OptionsLanguageHeaderLabel text="Language" class="options-menu__section-header" picking-mode="Ignore" />
                <menu:OptionsLanguageSection class="options-menu__languages">
                    <uibox:ChoiceGroupElement>
                        <uibox:ChoiceEntryElement label-text="en" />
                        <uibox:ChoiceEntryElement label-text="fr" />
                        <uibox:ChoiceEntryElement label-text="ja" />
                    </uibox:ChoiceGroupElement>
                </menu:OptionsLanguageSection>
                <menu:OptionsConfirmSection class="options-menu__confirm">
                    <uibox:ChoiceEntryElement label-text="Okay" />
                    <uibox:ChoiceEntryElement label-text="Nah" />
                </menu:OptionsConfirmSection>
            </ui:VisualElement>
            <uibox:BackExitButton class="uibox__back-exit">
                <ui:VisualElement class="uibox-back-exit__backing" picking-mode="Ignore" />
                <frankie:FrameElement class="uibox-back-exit__frame" />
                <ui:Label text="x" class="uibox-back-exit__label" picking-mode="Ignore" />
            </uibox:BackExitButton>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

.game-win-menu__title {
    margin-top: 150px;
}

.game-win-menu__name {
    margin-top: 30px;
}

.game-win-menu__credits {
    margin-top: 130px;
    align-items: center;
}

.game-win-menu__credits-header {
    margin: 0;
    padding: 0;
    font-size: 40px;
    -unity-text-align: middle-center;
}

.credits-entry {
    flex-direction: row;
    justify-content: center;
    height: 52px;
}

.credits-entry__title,
.credits-entry__person {
    margin: 0;
    padding: 0;
    /*noinspection CssInvalidPropertyValue*/
    white-space: pre;
}

.game-win-menu__choices {
    margin-top: 120px;
}

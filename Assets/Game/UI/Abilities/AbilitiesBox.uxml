<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uibox="LowDefMustard.UIBox" xmlns:frankie="Frankie.Utils.UI" xmlns:combat="Frankie.Combat.UI" editor-extension-mode="false">
    <ui:VisualElement class="abilities-box-screen" picking-mode="Ignore">
        <ui:VisualElement class="uibox abilities-box">
            <ui:VisualElement class="uibox__backing" picking-mode="Ignore" />
            <frankie:FrameElement class="uibox__frame" />
            <uibox:ChoiceEntryContainer choice-layout="Horizontal" class="party-selector party-selector--dimmed" picking-mode="Ignore" />
            <ui:VisualElement class="abilities-box__divider" picking-mode="Ignore" />
            <ui:VisualElement class="abilities-box__selection" picking-mode="Ignore">
                <combat:SkillWheelContainer class="abilities-box__wheel" />
                <ui:VisualElement class="abilities-box__selection-divider" picking-mode="Ignore" />
                <ui:VisualElement class="abilities-box__selected" picking-mode="Ignore">
                    <combat:SkillSelectionCharacterLabel text="--" class="abilities-box__selected-character" picking-mode="Ignore" />
                    <combat:SkillSelectionActiveSkillLabel text="--" class="abilities-box__selected-skill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="abilities-box__divider" picking-mode="Ignore" />
            <ui:VisualElement class="abilities-box__details" picking-mode="Ignore">
                <ui:VisualElement class="abilities-box__detail-line" picking-mode="Ignore">
                    <combat:AbilitiesStatLabel text="Inclination:" class="abilities-box__detail-label" picking-mode="Ignore" />
                    <combat:AbilitiesStatValueLabel class="abilities-box__detail-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="abilities-box__detail-line" picking-mode="Ignore">
                    <combat:AbilitiesAPCostLabel text="AP Cost:" class="abilities-box__detail-label" picking-mode="Ignore" />
                    <combat:AbilitiesAPCostValueLabel class="abilities-box__detail-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <combat:AbilitiesDetailLabel class="abilities-box__detail-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <uibox:BackExitButton class="uibox__back-exit">
                <ui:VisualElement class="uibox-back-exit__backing" picking-mode="Ignore" />
                <frankie:FrameElement class="uibox-back-exit__frame" />
                <ui:Label text="x" class="uibox-back-exit__label" picking-mode="Ignore" />
            </uibox:BackExitButton>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

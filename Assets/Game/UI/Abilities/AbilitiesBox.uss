/* Top-centre, 50px down.  Fixed width. */
/* Note:  Skill wheel + active skill label styles live in SkillWheel.uss (shared with the battle SkillSelection) */
.abilities-box-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.abilities-box {
    margin-top: 50px;
    width: 1200px;
    padding: 20px 40px 30px 40px;
}

.abilities-box__divider {
    height: 2px;
    margin: 15px 0;
    background-color: var(--text-colour-default);
}

.abilities-box__selection {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 20px 50px;
}

.abilities-box__wheel {
    flex-grow: 1;
    align-items: center;
}

.abilities-box__selection-divider {
    width: 2px;
    align-self: stretch;
    margin: 0 50px;
    background-color: var(--text-colour-default);
}

.abilities-box__selected {
    width: 300px;
    align-items: center;
}

.abilities-box__selected > .unity-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* Note:  Child selector to outrank the label margin reset above */
.abilities-box__selected > .abilities-box__selected-character {
    margin-bottom: 38px;
}

.abilities-box__detail-line {
    flex-direction: row;
}

.abilities-box__details .unity-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.abilities-box__detail-label {
    width: 250px;
}

.abilities-box__detail-text {
    white-space: normal;
}

/* ~ Text Fit ~ */
.abilities-box__selected > .unity-label {
    max-width: 100%;
    white-space: nowrap;
    -unity-text-auto-size: best-fit 24px 64px;
}

.abilities-box__detail-line > .unity-label {
    flex-shrink: 1;
    white-space: nowrap;
    -unity-text-auto-size: best-fit 24px 64px;
}

/* The wheel's area is whatever the selected pane leaves, whatever the skill names measure (so they have a width to fit) */
.abilities-box__wheel {
    flex-basis: 0;
}

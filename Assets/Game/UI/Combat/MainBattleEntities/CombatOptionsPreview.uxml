<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uibox="LowDefMustard.UIBox" xmlns:frankie="Frankie.Utils.UI" editor-extension-mode="false">
    <!-- UI Builder preview only (set canvas to 2560x1440):  mirrors CombatOptions.uxml with sample entries - keep in sync -->
    <!-- Style order matches the CombatOptions view:  shared theme sheets, then screen sheets -->
    <Style src="../../_UIToolkit/Styles/Tokens.uss" />
    <Style src="../../_UIToolkit/Styles/UIBox.uss" />
    <Style src="CombatOptions.uss" />
    <ui:VisualElement class="combat-options-screen" picking-mode="Ignore">
        <ui:VisualElement class="uibox combat-options">
            <ui:VisualElement class="uibox__backing" picking-mode="Ignore" />
            <frankie:FrameElement class="uibox__frame" />
            <uibox:ChoiceEntryContainer choice-layout="Horizontal" class="combat-options__choices" picking-mode="Ignore">
                <uibox:ChoiceEntryElement label-text="Fight" highlighted="true" />
                <uibox:ChoiceEntryElement label-text="Item" />
                <uibox:ChoiceEntryElement label-text="Stats" />
                <uibox:ChoiceEntryElement label-text="Run Away" />
            </uibox:ChoiceEntryContainer>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
